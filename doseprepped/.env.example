# DosePrepped — environment variable reference.
# Copy this file to .env in the same directory and fill in real values for
# your local environment. Never commit an actual .env file.
#
# This file lists every variable used across the monorepo. Individual apps
# read the ones relevant to them (see apps/patient/.env.example and
# apps/api/.env.example for the per-app subsets).

# ---------------------------------------------------------------------------
# Database (packages/db, apps/api)
# ---------------------------------------------------------------------------
# Local dev Postgres connection string. Never point this at a database that
# contains real patient data — M0/MVP synthetic-data policy applies.
DATABASE_URL="postgresql://doseprepped:changeme@localhost:5432/doseprepped_dev"

# ---------------------------------------------------------------------------
# Backend API (apps/api)
# ---------------------------------------------------------------------------
NODE_ENV="development"
API_PORT="4000"
API_HOST="0.0.0.0"

# Session/cookie signing secret. Generate a real random value per
# environment (e.g. `openssl rand -base64 32`) — do not reuse this placeholder.
SESSION_SECRET="replace-with-a-random-32-byte-secret"

# Comma-separated list of frontend origins allowed to call this API with
# credentials (CORS).
APP_ORIGINS="http://localhost:3000"

# ---------------------------------------------------------------------------
# Patient frontend (apps/patient)
# ---------------------------------------------------------------------------
# Base URL the frontend uses to reach the backend API.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---------------------------------------------------------------------------
# Reserved for later milestones (not used in M0 — listed here so the env
# surface is documented up front; do not populate until the corresponding
# milestone implements the feature)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# S3_BUCKET_NAME=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
