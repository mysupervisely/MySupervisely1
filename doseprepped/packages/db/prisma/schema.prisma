// DosePrepped database schema — through M4 (pharmacist review &
// concierge workflow).
//
// This covers the DB framework, the patient/pharmacist/admin role
// structure, authentication (User + Session), a patient's manually-entered
// medication list, medication question intake (MedicationQuestion),
// deterministic safety/disposition routing (Phase 2), AI-assisted
// education/summary generation gated behind that disposition (Phase 3),
// and the pharmacist queue/claim/respond/escalate workflow (M4). Provider
// messaging, B2B organizations, and payments remain out of scope —
// deliberately not implemented here.

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  PHARMACIST
  ADMIN
}

model User {
  id           String    @id @default(uuid())
  role         Role
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  medications         PatientMedication[]
  sessions            Session[]
  questions           MedicationQuestion[] @relation("PatientQuestions")
  pharmacistQuestions MedicationQuestion[] @relation("PharmacistQuestions")

  @@map("users")
}

/// An active login session, identified to the browser by an opaque cookie
/// token. Only a salted hash of the token is stored — see
/// packages/auth/src/session.ts — so a database read alone can't be used to
/// impersonate a session.
model Session {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

enum MedicationStatus {
  ACTIVE
  INACTIVE
}

/// Manually-entered medication on a patient's profile. This is patient-
/// reported data, not authoritative medication reference data — see
/// MedicationReference below and the Medication Data Abstraction Layer note
/// in docs/doseprepped/ARCHITECTURE.md.
///
/// Records are never hard-deleted by the patient — "removing" a medication
/// sets status to INACTIVE and stamps archivedAt, preserving history for
/// future audit/adherence/history features. Rows are cascade-deleted only
/// if the owning account itself is deleted (see User), which is a separate,
/// not-yet-implemented concern from a patient archiving one medication.
model PatientMedication {
  id         String           @id @default(uuid())
  patient    User             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId  String
  name       String
  strength   String
  dosageForm String
  directions String
  frequency  String
  route      String
  startDate  DateTime
  endDate    DateTime?
  notes      String?
  status     MedicationStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  archivedAt DateTime?

  questions MedicationQuestion[]

  @@index([patientId])
  @@map("patient_medications")
}

/// Synthetic/demo medication reference data used only to power a basic
/// name autocomplete on the "Add Medication" form. This is NOT an
/// authoritative medication database and must never be presented as one —
/// see isSynthetic/source below and docs/doseprepped/ARCHITECTURE.md
/// "Medication Data Abstraction Layer". A future provider backed by
/// RxNorm/DailyMed/FDA sources would populate this same shape (or replace
/// the lookup entirely) behind packages/db/src/medication-reference.ts's
/// MedicationDataProvider interface, without any caller needing to change.
model MedicationReference {
  id          String   @id @default(uuid())
  name        String
  strength    String?
  dosageForm  String?
  isSynthetic Boolean  @default(true)
  source      String   @default("synthetic_demo")
  createdAt   DateTime @default(now())

  @@index([name])
  @@map("medication_reference")
}

enum QuestionCategory {
  GENERAL_INFO
  ADMINISTRATION
  MISSED_DOSE
  SIDE_EFFECT
  DRUG_INTERACTION
  STORAGE
  ADHERENCE
  COST_ACCESS
  OTHER
}

/// The routing outcome of the deterministic safety/disposition rule engine
/// (packages/safety-rules) — see docs/doseprepped/ARCHITECTURE.md
/// "Deterministic Safety & Disposition Rule Engine". Assigned synchronously
/// at question creation time by rules alone; no AI/LLM call is involved.
/// This is a routing decision, never a diagnosis or treatment
/// recommendation.
///
/// Renamed/expanded in M3 Phase 2 from the original 3-value Phase 1 sketch
/// (ROUTINE / PHARMACIST_RECOMMENDED / URGENT_CARE_GUIDANCE), which
/// conflated "needs a pharmacist" with "needs a provider" and had no way
/// to distinguish a non-emergency provider concern from a true emergency.
/// Safe to rename: disposition was never populated before Phase 2 (always
/// null), so no data migration is affected.
enum QuestionDisposition {
  GENERAL_EDUCATION
  PHARMACIST_REVIEW
  PROVIDER_EVALUATION
  URGENT_EMERGENCY
}

/// Distinguishes a disposition the deterministic rule engine assigned
/// (the only source that exists today) from one a future AI-assisted
/// refinement pass assigned or adjusted. An AI-assisted result may only
/// ever escalate a deterministic disposition toward more caution, never
/// replace or downgrade it — see docs/doseprepped/ARCHITECTURE.md.
enum DispositionSource {
  DETERMINISTIC
  AI_ASSISTED
}

/// Outcome of the M3 Phase 3 AI education call for a given question. See
/// docs/doseprepped/ARCHITECTURE.md "Output validation (FAIL SAFE)".
/// SKIPPED means the provider was deliberately never called (disposition
/// is URGENT_EMERGENCY) — distinct from FAILED (the provider was called
/// but its output could not be trusted).
enum AiResponseStatus {
  SUCCESS
  FAILED
  SKIPPED
}

/// Question lifecycle. RECEIVED and AI_ANSWERED are set by POST /questions
/// (Phase 1/3). As of M4, PHARMACIST_REQUESTED is also set by POST
/// /questions (automatically, when disposition is PHARMACIST_REVIEW or
/// PROVIDER_EVALUATION — see docs/doseprepped/ARCHITECTURE.md "Why queue
/// entry is automatic"), and PHARMACIST_IN_PROGRESS / PHARMACIST_RESOLVED
/// / ESCALATED are set by the pharmacist claim/respond/escalate routes.
/// WAITING_FOR_PATIENT and CLOSED remain reserved — no two-way thread UI
/// exists yet.
enum QuestionStatus {
  RECEIVED
  AI_PROCESSING
  AI_ANSWERED
  PHARMACIST_REQUESTED
  PHARMACIST_IN_PROGRESS
  WAITING_FOR_PATIENT
  PHARMACIST_RESOLVED
  ESCALATED
  CLOSED
}

/// Closed taxonomy for why a pharmacist escalated a question to provider
/// evaluation (M4). Paired with the free-text escalationReason field on
/// MedicationQuestion to satisfy "a structured escalation reason" — a
/// category plus a human explanation, not either alone. See
/// docs/doseprepped/ARCHITECTURE.md "Escalation behavior".
enum EscalationReasonCategory {
  WORSENING_OR_SEVERE_SYMPTOM
  POSSIBLE_ADVERSE_REACTION
  MEDICATION_ERROR
  BEYOND_PHARMACIST_SCOPE
  PATIENT_REQUESTED_PROVIDER
  OTHER
}

/// A patient's question about one of their own medications — the core
/// entity of the "digital medication-support layer" direction (see
/// docs/doseprepped/ARCHITECTURE.md "M3 — The Digital Medication-Support
/// Layer"). M3 Phase 1 implemented structured intake; M3 Phase 2 added
/// deterministic disposition routing; M3 Phase 3 added a single, typed,
/// validated AI education call (packages/ai-service) gated behind that
/// disposition — no pharmacist review, no escalation messaging, and no
/// multi-turn conversation exist yet. Every field that belongs to a
/// still-later phase is present here already (so those phases don't need
/// a migration) but is always null / at its initial value until that
/// phase is built.
model MedicationQuestion {
  id           String            @id @default(uuid())
  patient      User              @relation("PatientQuestions", fields: [patientId], references: [id], onDelete: Cascade)
  patientId    String
  medication   PatientMedication @relation(fields: [medicationId], references: [id])
  medicationId String

  /// Point-in-time snapshot of the medication's relevant fields
  /// ({name, strength, directions, frequency, route}) at question creation.
  /// Deliberately NOT re-derived from the live PatientMedication row on
  /// read — if the patient edits that medication later (M2
  /// PATCH /medications/:id), this question's history must not change.
  medicationSnapshot Json

  /// Minimal {name, strength}[] snapshot of the patient's other ACTIVE
  /// medications at question creation, captured only for categories where
  /// cross-medication context is relevant (DRUG_INTERACTION, SIDE_EFFECT).
  /// Null for every other category — not collected unless needed.
  otherMedicationsSnapshot Json?

  /// Patient-selected category — the source of truth. AI may later suggest
  /// a category (aiSuggestedCategory) but never overrides this one.
  category            QuestionCategory
  aiSuggestedCategory QuestionCategory?

  questionText String

  /// {question, answer} — at most one AI clarifying exchange. Populated by
  /// Phase 3 as {question, answer: null} when the AI provider returns a
  /// clarifying question; `answer` is reserved for a future two-way flow
  /// and is never written to today — the system proceeds without waiting
  /// for one. Always null for GENERAL_EDUCATION-disposition questions
  /// where the provider didn't offer one, and always null for
  /// URGENT_EMERGENCY (AI never runs).
  clarifyingExchange Json?

  /// Routing disposition assigned by packages/safety-rules at creation
  /// time — see the QuestionDisposition doc comment above. Populated for
  /// every question as of M3 Phase 2 (never null going forward).
  disposition QuestionDisposition?

  /// Always DETERMINISTIC today — no AI-assisted refinement exists yet.
  dispositionSource DispositionSource?

  /// Named safety-rule id(s) that fired (see packages/safety-rules), or an
  /// empty array if only the category baseline applied. Lets a clinical
  /// reviewer see exactly why a question got the disposition it did.
  dispositionRuleIds String[] @default([])

  /// The packages/safety-rules SAFETY_RULE_SET_VERSION that produced this
  /// disposition — any two questions with the same version were evaluated
  /// by byte-identical rules. A later rule change never retroactively
  /// changes an already-assigned disposition.
  safetyRuleSetVersion String?

  dispositionAssignedAt DateTime?

  /// General educational content (GENERAL_EDUCATION) or brief supplementary
  /// context (PHARMACIST_REVIEW / PROVIDER_EVALUATION) generated by
  /// packages/ai-service. Null until Phase 3's AI call runs and succeeds;
  /// stays null on failure (fail-safe — nothing fabricated is ever stored
  /// or shown) or on URGENT_EMERGENCY (never called at all).
  aiEducationResponse    String?
  aiEducationGeneratedAt DateTime?
  /// Which AI model produced aiEducationResponse, for audit — e.g.
  /// "mock-v1" or a real model identifier.
  aiModelVersion         String?
  /// Which provider implementation ran — "mock" | "anthropic".
  aiProvider             String?
  /// packages/ai-service PROMPT_VERSION at call time, so a later prompt
  /// change never retroactively reinterprets a past response.
  aiPromptVersion        String?
  /// SUCCESS / FAILED / SKIPPED — see AiResponseStatus above.
  aiResponseStatus       AiResponseStatus?
  /// {inputTokens, outputTokens} — stored per question so AI cost can be
  /// aggregated later (by day/disposition/category) without a separate
  /// cost-tracking table.
  aiUsage                Json?
  /// {summaryText, isAiGenerated: true} — generated in Phase 3 when
  /// disposition is PHARMACIST_REVIEW or PROVIDER_EVALUATION, surfaced
  /// read-only on the pharmacist review screen as of M4 (an assistive
  /// starting point, never the response itself).
  aiPharmacistSummary    Json?

  /// PHARMACIST_REQUESTED/_IN_PROGRESS/_RESOLVED/ESCALATED are all
  /// implemented (M4) — see the QuestionStatus doc comment above.
  status QuestionStatus @default(RECEIVED)

  /// The one pharmacist who claimed this question — set exclusively by
  /// POST /pharmacist/questions/:id/claim via an atomic conditional
  /// update (see docs/doseprepped/ARCHITECTURE.md "Claim concurrency").
  /// The same pharmacist is the only one who may respond, escalate, or
  /// release it.
  pharmacist            User?     @relation("PharmacistQuestions", fields: [pharmacistId], references: [id])
  pharmacistId          String?
  /// Stamped when status becomes PHARMACIST_REQUESTED — at question
  /// creation (M4's automatic queueing), not at claim time.
  pharmacistRequestedAt DateTime?
  pharmacistClaimedAt   DateTime?
  /// The pharmacist's own words — written only by POST
  /// /pharmacist/questions/:id/respond, never by any AI/LLM call, and
  /// stored in a column entirely separate from aiEducationResponse.
  pharmacistResponse    String?
  pharmacistRespondedAt DateTime?

  /// Pharmacist-initiated only (see docs/doseprepped/ARCHITECTURE.md §8)
  /// — the automatic URGENT_EMERGENCY intake-time routing never sets
  /// this; only POST /pharmacist/questions/:id/escalate does.
  escalatedAt      DateTime?
  /// The escalating pharmacist's free-text explanation, required
  /// alongside escalationReasonCategory below.
  escalationReason String?
  /// Closed-taxonomy escalation reason, required by the API on escalate.
  /// See the EscalationReasonCategory doc comment above.
  escalationReasonCategory EscalationReasonCategory?

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([patientId])
  @@index([status])
  @@index([medicationId])
  @@map("medication_questions")
}
