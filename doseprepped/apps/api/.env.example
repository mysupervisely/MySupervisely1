# Copy to apps/api/.env for local development.
NODE_ENV="development"
API_PORT="4000"
API_HOST="0.0.0.0"
DATABASE_URL="postgresql://doseprepped:changeme@localhost:5432/doseprepped_dev"
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-32-byte-secret"
# Comma-separated list of frontend origins allowed to call this API with credentials.
APP_ORIGINS="http://localhost:3000"
