# Copy to apps/api/.env for local development.
NODE_ENV="development"
API_PORT="4000"
API_HOST="0.0.0.0"
DATABASE_URL="postgresql://doseprepped:changeme@localhost:5432/doseprepped_dev"
# Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-32-byte-secret"
# Comma-separated list of frontend origins allowed to call this API with credentials.
APP_ORIGINS="http://localhost:3000"

# M3 Phase 3 — AI-assisted medication education (see @doseprepped/ai-service).
# "mock" (default) never calls a real AI vendor and is what this codebase
# actually runs with — its output is clearly synthetic, not real
# AI-generated content. Set AI_PROVIDER="anthropic" and provide a real
# ANTHROPIC_API_KEY only in an environment that has completed the legal/
# privacy review described in docs/doseprepped/ARCHITECTURE.md.
AI_PROVIDER="mock"
# ANTHROPIC_API_KEY="replace-with-a-real-key"
# ANTHROPIC_MODEL="claude-sonnet-5"
# Milliseconds before an AI provider call is abandoned and the question
# fails safe to the existing disposition routing message.
AI_TIMEOUT_MS="8000"
