# M10 — preview/staging environment config. Used by the EAS Build "preview" profile
# (see eas.json) for internal/TestFlight-style builds shared with testers before a
# production release. See docs/M10_IMPLEMENTATION_NOTES.md "Environment configuration".

EXPO_PUBLIC_APP_ENV=preview

# Point this at the staging deployment of the PharmDPrepped Netlify backend.
EXPO_PUBLIC_API_BASE_URL=https://REPLACE_WITH_PREVIEW_PHARMDPREPPED_ORIGIN.example
