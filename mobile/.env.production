# M10 — production environment config. Used by `npx expo export`/EAS Build's
# "production" profile, and by default whenever NODE_ENV=production (release builds).
# See docs/M10_IMPLEMENTATION_NOTES.md "Environment configuration".

EXPO_PUBLIC_APP_ENV=production

# Point this at the real, live PharmDPrepped Netlify backend once it exists.
# NOT YET a real deployed origin — see docs/M8_IMPLEMENTATION_NOTES.md /
# docs/M9_IMPLEMENTATION_NOTES.md "Base URL" for why this is intentionally a
# placeholder rather than a guessed domain.
EXPO_PUBLIC_API_BASE_URL=https://REPLACE_WITH_PRODUCTION_PHARMDPREPPED_ORIGIN.example
