# M10 — template for a personal local override. Copy to `.env.local` (gitignored,
# see .gitignore's `.env*.local` rule) to point your own dev build at a different
# backend without touching the committed .env.development. Values here are examples,
# not real endpoints — see docs/M10_IMPLEMENTATION_NOTES.md "Environment configuration".

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=https://your-local-or-ngrok-tunnel.example
