# M10 — development environment config. Loaded automatically by `npx expo start`
# (Metro's default NODE_ENV is "development", and Expo maps that to this file).
# See docs/M10_IMPLEMENTATION_NOTES.md "Environment configuration" for the full picture.
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time — never put a
# secret here. This file is committed on purpose (no secrets, just a public base URL).

EXPO_PUBLIC_APP_ENV=development

# Point this at your local/dev deployment of the PharmDPrepped Netlify backend
# (docs/MOBILE_MIGRATION_AUDIT.md §G). Left as an intentionally non-resolving
# placeholder until a real dev backend exists — see apiConfig.ts.
EXPO_PUBLIC_API_BASE_URL=https://REPLACE_WITH_DEV_PHARMDPREPPED_ORIGIN.example
