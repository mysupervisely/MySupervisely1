// Noor database schema — M1 (Foundations).
//
// This is a deliberately narrower slice of the full model approved in
// docs/noor/ARCHITECTURE.md §C ("Initial Database Schema"). M1's scope is
// identity, roles, sessions, the minimum patient/clinician records needed
// to demonstrate ownership/care-relationship-scoped authorization, and the
// audit trail. Per the project's milestone discipline ("work in
// milestones," "do not build everything at once" — see AGENTS-equivalent
// dev rules in the product brief), the remaining M0-approved tables are
// intentionally NOT created yet and will each arrive as their own
// migration, documented at that time, alongside the milestone that
// actually implements the feature that needs them:
//
//   - CheckInQuestion / CheckIn / CheckInResponse   -> implemented in M3,
//     see the "Noor Check-In" section below and docs/noor/M3-IMPLEMENTATION.md
//   - ClinicianReview / CareGoal                     -> M4 (Clinician dashboard v1)
//   - ClinicianLicense (state licensing)               -> M5 (Provider directory)
//   - ExternalRecordMapping                              -> M6 (EHR/AI abstractions wired in)
//   - SubscriptionPlan / Subscription / SubscriptionEvent -> M7 (Subscriptions)
//   - ProviderAvailability / Appointment                    -> M8 (Scheduling v1)
//   - Notification, ConsentRecord                             -> alongside the
//     feature that first triggers a notification / requires recorded
//     consent (onboarding in M2 for ConsentRecord; earliest transactional
//     email in M3+ for Notification)
//
// This is a scope decision, not an oversight — see
// docs/noor/M1-IMPLEMENTATION.md "Database foundation."

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity, roles, sessions
// ---------------------------------------------------------------------------

enum RoleName {
  PATIENT
  CLINICIAN
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// Seeded, closed set of the four roles defined in
/// docs/noor/ARCHITECTURE.md §E. Not user-editable via any API in M1.
model Role {
  id    Int      @id @default(autoincrement()) @db.SmallInt
  name  RoleName @unique

  users UserRole[]

  @@map("roles")
}

/// Account record shared by every role. Deliberately holds no clinical
/// content and no onboarding-collected PII — that lives in PatientProfile /
/// ClinicianProfile so a person's role-specific sensitive data is never
/// reachable through a bare User row. `displayName` exists only for
/// ADMIN/SUPER_ADMIN accounts, which have no profile table of their own
/// (there is no clinical or directory-facing reason for one) — it is never
/// treated as PHI.
///
/// MFA: `mfaEnabled` and (future) TOTP secret storage are modeled here so
/// the schema doesn't need to change when MFA enforcement is implemented,
/// but M1 does not implement MFA enrollment/verification — see
/// docs/noor/M1-IMPLEMENTATION.md "Known limitations."
model User {
  id                String     @id @default(uuid())
  email             String     @unique
  passwordHash      String
  displayName       String?
  status            UserStatus @default(PENDING_VERIFICATION)
  mfaEnabled        Boolean    @default(false)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  roles             UserRole[]
  sessions          Session[]
  patient           Patient?
  clinician         Clinician?
  auditEvents       AuditEvent[]

  @@map("users")
}

/// Join table for User<->Role. The schema permits a user to hold more than
/// one role; M1 policy is that every account is provisioned with exactly
/// one role and no UI exists for switching roles. Whether a single person
/// may ever legitimately hold two roles (e.g. PATIENT and CLINICIAN) is an
/// open product/compliance question — see docs/noor/ARCHITECTURE.md §N.
model UserRole {
  userId String
  roleId Int    @db.SmallInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// An active login session, identified to the browser by an opaque cookie
/// token. Only a SHA-256 hash of the token is persisted (see
/// packages/auth/src/session.ts) — a database read alone cannot be used to
/// impersonate a session. `issuedForApp` records which frontend
/// (patient/clinician/admin) the session was created for, for audit
/// clarity only; it is not used to enforce anything in M1.
model Session {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  tokenHash    String   @unique
  issuedForApp String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Patients
// ---------------------------------------------------------------------------

model Patient {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId    String   @unique
  createdAt DateTime @default(now())

  profile           PatientProfile?
  careRelationships CareRelationship[]
  checkIns          CheckIn[]

  @@map("patients")
}

/// "What brings you to Noor?" — a fixed, non-diagnostic set of
/// self-reported reasons for arriving at Noor, replaced from a free-text
/// field in an early M2 iteration once the product brief specified fixed
/// options instead (see docs/noor/M2-IMPLEMENTATION.md "Revision" note).
/// A closed enum is also a stronger PHI-minimization property than free
/// text: there is no way for a patient to type clinical history into this
/// field even by accident.
enum NoorInterest {
  LOOKING_FOR_THERAPIST
  ONGOING_SUPPORT
  ASYNC_SUPPORT_INTEREST
  EXPLORING_OPTIONS
  NOT_SURE
}

enum CareType {
  INDIVIDUAL_THERAPY
  COUPLES_THERAPY
  FAMILY_THERAPY
  PSYCHIATRY
  ASYNC_SUPPORT
  NOT_SURE
}

enum CareFormatPreference {
  VIDEO
  ASYNC
  BOTH
  NOT_SURE
}

/// Onboarding-collectible, non-clinical fields only (brief §6: "do not
/// collect unnecessary sensitive clinical information during initial
/// onboarding"). M1 provisioned an empty row at signup; M2 adds the
/// specific onboarding fields — first/last name, state, and three
/// self-reported preference enums (never free text — see NoorInterest
/// above). These stay on PatientProfile rather than a separate
/// "preferences" table deliberately: they are a fixed, small, 1:1 set of
/// scalar fields describing this one patient's own onboarding answers,
/// not a growing or multi-valued domain (unlike, say, CareGoal or
/// Appointment) — splitting them out would be premature structure with no
/// present benefit (see docs/noor/M2-IMPLEMENTATION.md §13 for the full
/// reasoning). `onboardingCompletedAt` is set once, by
/// POST /patients/me/onboarding/complete, the first time all required
/// fields are present — see packages/api/src/routes/patients.ts.
model PatientProfile {
  id                     String                @id @default(uuid())
  patient                Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId              String                @unique
  firstName              String?
  lastName               String?
  state                  String?               @db.Char(2)
  city                   String?
  whatBringsYouToNoor    NoorInterest?
  careType               CareType?
  careFormatPreference   CareFormatPreference?
  onboardingCompletedAt  DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([state])
  @@map("patient_profiles")
}

// ---------------------------------------------------------------------------
// Clinicians
// ---------------------------------------------------------------------------

enum ClinicianStatus {
  ACTIVE
  INACTIVE
  ONBOARDING
}

model Clinician {
  id                     String          @id @default(uuid())
  user                   User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId                 String          @unique
  status                 ClinicianStatus @default(ONBOARDING)
  acceptingNewPatients   Boolean         @default(false)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  profile           ClinicianProfile?
  careRelationships CareRelationship[]
  reviewedCheckIns  CheckIn[]

  @@map("clinicians")
}

/// Public/directory-facing fields only, deliberately separate from
/// Clinician itself (which will hold private fields such as NPI and is
/// never exposed through a directory-style read). The provider directory
/// UI itself is M5 — this table exists in M1 only so a clinician has a
/// display name for the clinician-dashboard shell.
model ClinicianProfile {
  id                String    @id @default(uuid())
  clinician         Clinician @relation(fields: [clinicianId], references: [id], onDelete: Cascade)
  clinicianId       String    @unique
  displayName       String
  credentialsDisplay String?
  bio               String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("clinician_profiles")
}

// ---------------------------------------------------------------------------
// Care relationships
// ---------------------------------------------------------------------------

enum CareRelationshipType {
  ASYNC
  THERAPY
  PSYCHIATRY
}

enum CareRelationshipStatus {
  REQUESTED
  ACTIVE
  PAUSED
  ENDED
}

/// The authorization anchor for clinician access to a patient (see
/// docs/noor/ARCHITECTURE.md §E "ownership scoping"). A CLINICIAN may only
/// read/act on a patient's data through an ACTIVE row here — enforced in
/// packages/api/src/rbac, never left to individual route handlers to
/// remember. M1 has no patient-initiated "request care" flow (that's M5)
/// or self-serve matching (M4 roadmap note: "admin-assigned for MVP") — the
/// only way a relationship is created in M1 is an ADMIN/SUPER_ADMIN action,
/// which is itself audited.
model CareRelationship {
  id               String                  @id @default(uuid())
  patient          Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  patientId        String
  clinician        Clinician               @relation(fields: [clinicianId], references: [id], onDelete: Restrict)
  clinicianId      String
  relationshipType CareRelationshipType    @default(ASYNC)
  status           CareRelationshipStatus  @default(REQUESTED)
  requestedAt      DateTime                @default(now())
  startedAt        DateTime?
  endedAt          DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  checkIns CheckIn[]

  @@index([patientId, status])
  @@index([clinicianId, status])
  @@map("care_relationships")
}

// ---------------------------------------------------------------------------
// Noor Check-In (M3) — the first clinical-content workflow in Noor.
//
// Noor's primary service is live therapy; the check-in extends continuity
// of care between sessions — it is deliberately NOT a standalone
// "Async"/messaging product (see docs/noor/M3-IMPLEMENTATION.md §2). No
// pricing, quota, cadence, or SLA is hardcoded anywhere in this schema.
// ---------------------------------------------------------------------------

enum CheckInResponseType {
  SCALE_1_10
  SINGLE_SELECT
  FREE_TEXT
}

/// Data-driven question definitions — the whole point being that adding,
/// retiring, or rewording a question is a data change (a new/updated row
/// + re-seed), never a frontend code change. Seeded, fixed application
/// configuration (like Role), not synthetic patient data — see
/// packages/api/src/lib/bootstrap.ts `ensureCheckInQuestionsSeeded`, run
/// in every environment including production, same as roles.
///
/// `options` (jsonb) holds `{ key, label }[]` for SINGLE_SELECT questions
/// only; null otherwise. `isActive` lets a question be retired without
/// deleting it (deleting would orphan historical CheckInResponse rows'
/// `questionId` foreign key) — inactive questions are excluded from
/// GET /check-ins/questions but remain fully joinable for history.
model CheckInQuestion {
  id            String              @id @default(uuid())
  key           String              @unique
  promptText    String
  responseType  CheckInResponseType
  options       Json?
  isRequired    Boolean             @default(true)
  displayOrder  Int
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  responses CheckInResponse[]

  @@map("check_in_questions")
}

enum CheckInStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  ARCHIVED
}

/// NONE/FLAGGED only in M3 — deliberately not a richer workflow
/// (UNDER_REVIEW/ESCALATED/RESOLVED) yet, since the actual clinical
/// escalation protocol is unresolved
/// ([NEEDS CLINICAL/LEGAL REVIEW] — see docs/noor/M3-IMPLEMENTATION.md
/// §"Safety policy architecture"). This field is populated once, at
/// submission time, by the deterministic evaluator in
/// packages/safety-policy — never by an LLM, never a clinical judgment,
/// never shown to the patient (see CheckIn.safetyStatus usage in
/// packages/api/src/routes/checkins.ts).
enum CheckInSafetyStatus {
  NONE
  FLAGGED
}

/// One check-in instance. `cadenceKey` is a free-form string, not an enum
/// tied to "weekly" — the brief explicitly requires cadence stay
/// configurable ("do not hard-code weekly into the underlying data
/// model"); the M3 UI happens to only ever write "weekly" today, but nothing
/// in the schema or API assumes that value. `careRelationshipId` is
/// nullable: a patient may check in whether or not they currently have an
/// active care relationship (brief §"core patient experience" — useful
/// between appointments, preparing for one, or on another future care
/// pathway) — the M3 clinician-read routes simply won't find anything to
/// authorize against for a check-in with no care relationship yet.
model CheckIn {
  id                   String               @id @default(uuid())
  patient              Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  patientId            String
  careRelationship     CareRelationship?    @relation(fields: [careRelationshipId], references: [id], onDelete: SetNull)
  careRelationshipId   String?
  status               CheckInStatus        @default(DRAFT)
  safetyStatus         CheckInSafetyStatus  @default(NONE)
  cadenceKey           String               @default("weekly")
  submittedAt          DateTime?
  reviewedAt           DateTime?
  reviewedByClinician  Clinician?           @relation(fields: [reviewedByClinicianId], references: [id], onDelete: SetNull)
  reviewedByClinicianId String?
  archivedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  responses CheckInResponse[]

  @@index([patientId, status])
  @@index([careRelationshipId])
  @@index([status])
  @@index([submittedAt])
  @@map("check_ins")
}

/// One answer to one question on one check-in. Snapshots the question's
/// prompt/type/option-label text AT THE TIME OF ANSWERING (brief §4:
/// "a submitted check-in must preserve the question and answer context at
/// the time of submission... historical check-ins must remain
/// understandable even if questions change later") — display code reads
/// the *Snapshot fields, never joins back to CheckInQuestion's *current*
/// wording, specifically so a later prompt/label edit can never rewrite
/// history. The FK to CheckInQuestion still exists (`onDelete: Restrict`,
/// so a question already answered can never be hard-deleted) for
/// reporting/joins by question key across time, not for display.
model CheckInResponse {
  id                      String              @id @default(uuid())
  checkIn                 CheckIn             @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  checkInId               String
  question                CheckInQuestion     @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionId              String
  questionKeySnapshot     String
  questionPromptSnapshot  String
  responseTypeSnapshot    CheckInResponseType
  valueNumeric            Int?
  valueOptionKey          String?
  valueOptionLabelSnapshot String?
  valueText               String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@unique([checkInId, questionId])
  @@map("check_in_responses")
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

/// Append-only. The application's runtime database role is granted INSERT
/// and SELECT only on this table — no UPDATE, no DELETE — so the audit
/// trail cannot be quietly edited by an application bug or a compromised
/// app credential (see docs/noor/ARCHITECTURE.md §J). `metadata` is jsonb
/// specifically so the application layer can enforce a field allowlist at
/// write time (see packages/api/src/audit) that keeps clinical *content*
/// out of the audit row — audit *that* a resource was accessed, never
/// *what it said*.
model AuditEvent {
  id          BigInt   @id @default(autoincrement())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorUserId String?
  actorRole   String?
  action      String
  entityType  String
  entityId    String
  metadata    Json     @default("{}")
  ipAddress   String?
  userAgent   String?
  occurredAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId, occurredAt])
  @@index([occurredAt])
  @@map("audit_events")
}
