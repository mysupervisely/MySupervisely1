# Noor — environment variable template (M1)
#
# Copy to .env in each package that needs it (packages/db, packages/api) or
# to a shared root .env consumed by dotenv. NEVER commit a real .env file.
# NEVER put production secrets in this file or in any development machine.

# --- Database (packages/db, packages/api) ---------------------------------
# Local dev / test only. Points at a synthetic-data-only database — never
# a database that has ever held real patient information. See
# docs/noor/M1-IMPLEMENTATION.md "Environment separation."
DATABASE_URL="postgresql://noor_app:noor_app_dev_password@localhost:5432/noor_dev"

# --- API (packages/api) ----------------------------------------------------
NODE_ENV="development"
API_PORT=4000
API_HOST="0.0.0.0"

# Used to sign session cookies (@fastify/cookie) so a tampered cookie value
# is rejected before it ever reaches a database lookup. Generate a real
# random value per environment — never reuse this example value.
SESSION_SECRET="dev-only-session-secret-change-me-32chars-minimum"

# Comma-separated list of allowed frontend origins for CORS. Must exactly
# match the origins the patient/clinician/admin apps are served from.
APP_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# Cookie Domain attribute. "localhost" lets the session cookie be shared
# across the three app ports in local dev (cookie matching ignores port).
# In staging/production this should be the shared parent domain, e.g.
# ".noortherapy.example", with COOKIE_SECURE=true.
SESSION_COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# Provider abstraction selection (see packages/ehr-adapter, payments-adapter,
# ai-service). "mock" is the only implementation that exists in M1 — no
# real EHR, payment processor, or AI provider is integrated yet.
EHR_PROVIDER="mock"
PAYMENT_PROVIDER="mock"
AI_PROVIDER="mock"

# --- Frontends (apps/patient, apps/clinician, apps/admin) ------------------
# Base URL each frontend uses to call the API directly from the browser.
NEXT_PUBLIC_API_URL="http://localhost:4000"
